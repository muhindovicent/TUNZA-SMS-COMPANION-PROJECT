# Copy to .env at the repository root. Never commit .env.
# Foundation development only; use an empty, synthetic-data PostgreSQL database.
APP_ENV=development

# Required: generate locally, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required: set locally. URL-encode special characters in the username/password.
# Format: postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/DATABASE
DATABASE_URL=

# Bounded local-development health-check timeouts (seconds / milliseconds).
DATABASE_CONNECT_TIMEOUT=3
DATABASE_POOL_TIMEOUT=3
DATABASE_STATEMENT_TIMEOUT_MS=3000

# Optional migration-owner connection. Leave blank to use DATABASE_URL locally.
# Never use a migration-owner connection as the eventual clinical runtime role.
MIGRATION_DATABASE_URL=

# Optional session and sign-in throttling overrides (draft defaults, see docs/phase-1b-1-authentication.md).
# SESSION_IDLE_TIMEOUT_SECONDS=1800
# SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
# CSRF_TOKEN_MAX_AGE_SECONDS=900
# LOGIN_RATE_LIMIT_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Only VITE_* variables are public browser configuration. Never put secrets there.
VITE_API_BASE_URL=/api/v1

# Server-side Vite development proxy target; not bundled into browser code.
API_PROXY_TARGET=http://127.0.0.1:5000
